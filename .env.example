# ============================================
# LifeMate 本地开发环境变量
# 使用方式：复制为 .env 后修改密码
#   Copy-Item .env.example .env
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=lifemate
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=lifemate

# 应用连接串（Node.js 使用）
# 注意：密码中的特殊字符会破坏 URL 解析，建议只用字母和数字
DATABASE_URL=postgresql://lifemate:change_me_to_a_strong_password@127.0.0.1:5432/lifemate

# ---------- Embedding 服务 ----------
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# bge-m3 权重所在的**宿主机绝对路径**（docker-compose 的 bind mount 用）
#
# ⚠️ 这是本文件里唯一允许出现绝对路径的地方：
#    两台机器的仓库根目录不同（家里 D:\workspace，公司 E:\workspace），
#    而 Docker 的 bind mount 不接受相对路径，因此该值必须按机器设置。
#    首次设置后不要再改，除非模型换了位置。
#
# 该目录应包含以下文件（约 2.13 GB）：
#    config.json              架构 xlm-roberta，hidden_size=1024
#    model.safetensors        权重（约 2.27 GB）
#    tokenizer.json
#    tokenizer_config.json
#
# 家里（当前机器）：
BGE_M3_MODEL_DIR=D:/workspace/RAG_system/rag_qa/models/bge-m3
#
# 公司机器请改为对应路径，例如：
# BGE_M3_MODEL_DIR=E:/workspace/RAG_system/rag_qa/models/bge-m3

# ---------- LLM Provider（对话模型）----------
# 决策：V1.0 使用 DeepSeek
# ⚠️ API Key 只放本文件（.env），永不提交、永不写进代码或示例
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-replace_with_your_real_key
