# ============================================
# LifeMate 本地开发环境变量
# 使用方式：复制为 .env 后修改密码
#   Copy-Item .env.example .env
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=lifemate
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=lifemate

# 应用连接串（Node.js 使用）
# 注意：密码中的特殊字符会破坏 URL 解析，建议只用字母和数字
DATABASE_URL=postgresql://lifemate:change_me_to_a_strong_password@127.0.0.1:5432/lifemate

# ---------- Embedding 服务 ----------
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 单次嵌入请求超时（ms）。本地 GPU 推理正常在 50ms 内，留足余量。
# ⚠️ EMBEDDING_DIM / EMBEDDING_MODEL 不是可自由调整的配置项：
#    它们与 VECTOR(1024) 列类型绑定，改错会导致写入被拒或检索静默失配，
#    启动时 env 校验会拦住不一致的值（审计 F-11）。
EMBEDDING_TIMEOUT_MS=10000

# bge-m3 权重所在的**宿主机绝对路径**（docker-compose 的 bind mount 用）
#
# ⚠️ 这是本文件里唯一允许出现绝对路径的地方：
#    两台机器的仓库根目录不同（家里 D:\workspace，公司 E:\workspace），
#    而 Docker 的 bind mount 不接受相对路径，因此该值必须按机器设置。
#    首次设置后不要再改，除非模型换了位置。
#
# 该目录应包含以下文件（约 2.13 GB）：
#    config.json              架构 xlm-roberta，hidden_size=1024
#    model.safetensors        权重（约 2.27 GB）
#    tokenizer.json
#    tokenizer_config.json
#
# 家里（当前机器）：
BGE_M3_MODEL_DIR=D:/workspace/RAG_system/rag_qa/models/bge-m3
#
# 公司机器请改为对应路径，例如：
# BGE_M3_MODEL_DIR=E:/workspace/RAG_system/rag_qa/models/bge-m3

# ---------- 应用服务 ----------
NODE_ENV=development

# ⚠️ 只绑回环地址。本项目保存私密生活数据（docs/03 §29），
#    改成 0.0.0.0 会让同网段任何人都能读写整个记忆库。
#    服务启动时若检测到非回环地址会打印告警。
HOST=127.0.0.1

# 服务端口。3000 太常被别的项目占用（实测撞过），这里用 2003。
# 前端用相对路径请求 API，改端口不需要动前端；CLI 从 env 读，也会自动跟上。
PORT=2003

# 日志级别：fatal | error | warn | info | debug | trace
# ⚠️ 日志禁止记录消息正文与记忆内容（docs/03 §29.1）——
#    这与级别无关，调成 debug 也不会打印正文。
LOG_LEVEL=info

# ---------- LLM Provider（对话模型）----------
# 决策：V1.0 使用 DeepSeek
# ⚠️ API Key 只放本文件（.env），永不提交、永不写进代码或示例
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com

# ⚠️ 用**真实模型名**，不要用别名。
#    2026-09-22 实测：该账号 /models 返回 deepseek-flash 与 deepseek-v4-pro，
#    而 'deepseek-chat' 是别名、会被路由到 deepseek-flash ——
#    表现为「请求 deepseek-chat、返回 model=deepseek-flash」，
#    会让日志与用量核算里的模型归属不准。换模型前先查 /models。
LLM_MODEL=deepseek-flash

LLM_API_KEY=sk-replace_with_your_real_key

# ⚠️ 推理模型的预算陷阱：
#    deepseek-flash 会先产出思维链再给回答，而 max_tokens 同时约束两者。
#    实测 max_tokens=32 时思维链吃掉全部预算 → 回答为空、finish_reason=length。
#    应用层对此有守卫（抛错并提示提高上限），不会静默返回空回答。
#    参考：答「请只回复两个字：收到」约需 14~51 推理 token + 2 回答 token，
#    但复杂任务（如记忆抽取的结构化输出）需要显著更高的预算。
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REASONING_RESERVE_RATIO=3
