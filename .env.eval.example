# ============================================
# 评测用环境变量（只缺 LLM 凭据时用这个）
#
# 为什么需要它：
#   离线评测既要**真实 LLM**（`.env` 里有 key），
#   又要**测试库**（评测会写数据，不能碰开发库）。
#   这两个属性在 .env / .env.test 里各有一半：
#     .env      有 key，但 DATABASE_URL 指向开发库
#     .env.test 是测试库，但 LLM_API_KEY 是占位值
#
#   两种正确做法：
#     ① 复制本文件为 .env.eval，填上真实 key（.env.eval 已 gitignore）
#        —— 它的值会**覆盖** .env（命令行里 .env.eval 在后，后者优先）
#     ② 临时覆盖库地址（不改文件）：
#        $env:DATABASE_URL="postgresql://lifemate:<密码>@127.0.0.1:5432/lifemate_test"
#        pnpm eval:extraction
#
#   ⚠️ 实测确认过覆盖顺序：`node --env-file=.env --env-file=.env.eval` 时
#      **后面的文件优先**。写反了会静默用错库（评测脚本的库保护能兜住，
#      但测试不会 —— 测试用的是独立的 .env.test）。
#
# ⚠️ 评测脚本有库保护：非测试库会拒绝运行，
#    除非显式设 ALLOW_EVAL_ON_DEV_DB=1（会往库里写数据）。
# ============================================

NODE_ENV=test

# ⚠️ 库名必须含 "test"
DATABASE_URL=postgresql://lifemate:change_me_to_a_strong_password@127.0.0.1:5432/lifemate_test

# ---------- Embedding ----------
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=10000

# ---------- 应用 ----------
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=warn

# ---------- LLM ----------
# ⚠️ 评测**必须**用真实 key，否则跑不了。
#    不要把填好的本文件提交（.env.eval 已在 .gitignore 里）。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-replace_with_your_real_key
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REASONING_RESERVE_RATIO=3
