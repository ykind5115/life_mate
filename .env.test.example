# ============================================
# LifeMate 测试环境变量（模板）
#
# 用法：
#   Copy-Item .env.test.example .env.test
#   然后按本机情况改密码与端口
#
# 为什么需要独立一份：
#   集成测试的夹具会**删除数据**。跑在开发库上会毁掉真实记忆
#   （2026-09-23 实际发生过：14 条记忆连同向量被测试清空）。
#   因此测试必须连一个可以随便毁掉的库。
#
# 创建测试库的完整步骤见 docs/05-environment-setup.md §9.6
# ============================================

NODE_ENV=test

# ============================================================
# 🔴 测试用户隔离 —— 不要删掉这一行
#
# 测试夹具会「取当前用户 → 清空它名下的数据」。
# 若当前用户是 'me'（真实数据所属账号），那删的就是真实使用数据，
# 其中对话记录不可再生。
#
# src/shared/test-guard.ts 的 assertIsolatedUser 会兜底：
# 这一行没了就报错，而不是删数据。
# ============================================================
LIFEMATE_USER_NAME=test-agent

# ⚠️ 库名必须含 "test"。
#    src/shared/test-guard.ts 会校验，不含就拒绝执行任何写数据的测试操作。
DATABASE_URL=postgresql://lifemate:change_me_to_a_strong_password@127.0.0.1:5432/lifemate_test

# ---------- Embedding ----------
# 测试里的 /memories/search 用例会真的调 embedding 服务：
# 检索链路是那个端点存在的意义，mock 掉就测不到真实行为。
EMBEDDING_BASE_URL=http://127.0.0.1:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=10000

# ---------- 应用 ----------
HOST=127.0.0.1
# 测试不监听端口（用 inject 直接打请求），这个值只是为了让 env 校验通过。
# 刻意与开发端口（2003）错开，避免误连。
PORT=2004
LOG_LEVEL=silent

# ---------- LLM ----------
# ⚠️ 不要填真实密钥。
#    测试全部注入假 Provider，不会调用模型；这里给占位值只为通过 env 校验
#    （LLM_API_KEY 是必填项）。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=test-placeholder-not-a-real-key
LLM_TIMEOUT_MS=5000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REASONING_RESERVE_RATIO=3
