{
  "name": "lifemate",
  "version": "0.1.0",
  "private": true,
  "description": "个人长期记忆型 AI Agent —— 以自然对话为入口，持续整理具有长期价值的信息",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/api/main.ts",
    "start": "node --env-file=.env --import tsx src/api/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.test --import tsx --test --test-isolation=process --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/database/migrate.ts",
    "db:check": "node --env-file=.env --import tsx src/database/check-connection.ts",
    "e2e:check": "node --env-file=.env --import tsx src/database/e2e-check.ts",
    "llm:check": "node --env-file=.env --import tsx src/llm/check.ts",
    "llm:e2e": "node --env-file=.env --import tsx src/memory/verify-extraction.ts",
    "eval:extraction": "node --env-file=.env --env-file-if-exists=.env.eval --import tsx src/evaluation/run-extraction-eval.ts",
    "eval:retrieval": "node --env-file=.env --env-file-if-exists=.env.eval --import tsx src/evaluation/run-retrieval-eval.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
