# 统一换行符，避免跨平台差异
# 说明：Docker / SQL / shell 脚本必须保持 LF，
#       否则在 Linux 容器中可能因 CRLF 报错
* text=auto eol=lf

*.sh    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf

*.md    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.ico   binary
*.dump  binary
*.7z    binary
