# 环境变量（含数据库密码，绝不提交）
.env

# 测试环境变量。
# ⚠️ 与 .env 同等对待：里面有数据库密码。测试库虽然有 test-guard 保护、
#    且不含真实数据，但凭据本身不该进版本库。
.env.test

# 评测环境变量（含真实 LLM key）
.env.eval

# 备份文件（含私密数据的明文，绝不提交）
backups/
*.dump
*.7z

# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 日志
*.log
logs/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
